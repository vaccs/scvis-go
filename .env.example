DB_HOST=localhost
DB_USER=scvis
DB_PASSWD=
DB_NAME=scvis
PORT=4000

# Server Mode Configuration
# Set to 'true' for development/local server, 'false' for production
LOCAL_SERVER=true

# Log Configuration
LOG_DIR=./log/scvisual
LOG_MAX_SIZE_MB=10
LOG_MAX_BACKUPS=5

# SSL Certificate Configuration
SSL_CERT_PATH=./tls/localhost.pem
SSL_KEY_PATH=./tls/localhost-key.pem

# Hosted deployment (Railway)
DB_PORT=3306
DB_CREATE_DATABASE=false
SERVER_PROTOCOL=https
VACCS_ADDR=localhost:3580
ADMIN_USERNAME=
ADMIN_EMAIL=
ADMIN_PASSWORD=
GITHUB_TOKEN=
