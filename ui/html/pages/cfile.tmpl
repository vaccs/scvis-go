{{define "title"}}View C File{{end}}

{{define "main"}}
    {{if .IsAuthenticated}}
        <h2>{{.CFile.Filename}}</h2>
        <pre>{{.CFile.CSource}}</pre>

        <form>
            <input type='hidden' name='csrf_token' value='{{.CSRFToken}}'>
            <div>
                <input type='submit' formaction="/cfile/view/{{.CFile.ID}}" formmethod="post" value='Back'>
            </div>
        </form>
    {{else}}
        <p>Please <a href="/user/login">log in</a> to view a C file from a project.</p>
    {{end}}
{{end}}