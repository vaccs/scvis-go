{{define "title"}}Update a Project{{end}}

{{define "main"}}
    {{if .IsAuthenticated}}
        <form enctype="multipart/form-data">
        <input type='hidden' name='csrf_token' value='{{.CSRFToken}}'>
        <div>
            <label>Title:</label>
            <input type='text' name='title' value='{{.Project.Title}}'>
        </div>
        <div>
            {{if .Project.CFiles}}
                <label for="delete-files">C Files in Project:</label>
                <table>
                    <tr>
                        <th>Name</th>
                        <th>Delete</th>
                    </tr>
                    {{range .Project.CFiles}}
                        <tr>
                            <td><a href='/cfile/view/{{.ID}}'>{{.Filename}}</a></td>
                             <td>
                                <input type="checkbox" name="cfilesids" value="{{.ID}}">
                             </td>
                        </tr>
                    {{end}}
                </table>
            {{else}}
                <p>There are no C files in this project yet!</p>    
            {{end}}
        </div>
        <div>
            <input type="file" name="upload-files" accept=".c" multiple>
        </div>
        <div>
            <input type="submit" formaction="/project/update?id={{.Project.ID}}" formmethod="post" value="Update">
            <input type="submit" formaction="/" formmethod="post" value="Cancel">
        </div>
        </form>
    {{else}}
        <p>Please <a href="/user/login">log in</a> to create a project.</p>
    {{end}}
{{end}}