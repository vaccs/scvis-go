{{define "title"}}Project #{{.Project.ID}}{{end}}

{{define "main"}}
    {{with .Project}}
    <div class='project'>
        <div class='metadata'>
            <strong>{{.Title}}</strong>
            <span>#{{.ID}}</span>
        </div>
        {{range .CFiles}}
            <div class='cfiles'>
            <strong>{{.Filename}}</strong>
            <span>#{{.ID}}</span>
            </div>
        {{end}}
        <div class='metadata'>
            <time>Created: {{humanDate .Created}}</time>
        </div>
    </div>
    {{end}}
{{end}}