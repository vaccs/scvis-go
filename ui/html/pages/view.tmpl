{{define "title"}}Project #{{.Project.ID}}{{end}}

{{define "main"}}
    {{if .IsAuthenticated}}
        {{with .Project}}
        <div class='project'>
            <form>
            <div class='metadata'>
                <strong>{{.Title}}</strong>
                <span>#{{.ID}}</span>
            </div>
            <div>
                {{if .CFiles}}
                <form>
                    <label for="delete-files">C Files in Project:</label>
                    <table>
                        <tr>
                            <th>Name</th>
                            <th>Delete</th>
                        </tr>
                        {{range .CFiles}}
                            <tr>
                                <td><a href='/cfile/view/{{.ID}}'>{{.Title}}</a></td>
                                <td>
                                    <input type="checkbox" name="delete" value="{{.ID}}">
                                </td>
                            </tr>
                        {{end}}
                    </table>
                    <button type="submit">Delete Selected Files</button>
                </form>
                {{else}}
                    <p>There are no C files in this project yet!</p>    
                {{end}}
            </div>
            <div>
                <input type="file" id="upload-files" name="upload-files" accept=".c" multiple>
                <input type='submit' formaction="/project/upload" formmethod="post" value='Upload C Files'>
            </div>
            <div>
                <input type='submit' formaction="/project/analyze" formmethod="post" value='Analyze Project'>
                <input type='submit' formaction="/project/visual" formmethod="get" value='Visual'>
                {{if .CFiles}}
                    <input type='submit' formaction="/project/delete" formmethod="post" value='Delete C Files'>
                {{end}}
                <input type="submit" formaction="/" formmethod="get" value="Done">
            </div>
            </form>
        </div>
        {{end}}
    {{else}}
        <p>Please <a href="/user/login">log in</a> to view a project.</p>
    {{end}}
{{end}}