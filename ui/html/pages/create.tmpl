{{define "title"}}Create a New Project{{end}}

{{define "main"}}
    {{if .IsAuthenticated}}
        <form enctype="multipart/form-data">
            <input type='hidden' name='csrf_token' value='{{.CSRFToken}}'>
            <div>
                <label>Title:</label>
                {{with .Form.FieldErrors.title}}
                    <label class='error'>{{.}}</label>
                {{end}}
                <input type='text' name='title' value='{{.Form.Title}}'>
            </div>
            <div>
                <label for="files">Add C files:</label>
                <input type="file" id="files" name="files" accept=".c" multiple>
            </div>
            <div>
                <input type='submit' formaction="/project/create" formmethod="post" value='Create Project'>
                <input type="submit" formaction="/" formmethod="get" value="Cancel">
            </div>
        </form>
    {{else}}
        <p>Please <a href="/user/login">log in</a> to create a project.</p>
    {{end}}
{{end}}