{{define "title"}}Home{{end}}

{{define "main"}}
    <h2>Recent Projects</h2>
    {{if .Projects}}
     <table>
        <tr>
            <th>Title</th>
            <th>Created</th>
            <th>ID</th>
        </tr>
        {{range .Projects}}
        <tr>
            <td><a href='/project/view/{{.ID}}'>{{.Title}}</a></td>
            <td>{{humanDate .Created}}</td>
            <td>#{{.ID}}</td>
        </tr>
        {{end}}
    </table>
    {{else}}
        <p>There are no projects yet!</p>
    {{end}}
{{end}}