{{define "title"}}Home{{end}}

{{define "main"}}
    {{if .IsAuthenticated}}
        <h2>Projects</h2>
        {{if .Projects}}
            <form>
                <table>
                    <tr>
                        <th>Title</th>
                        <th>Created</th>
                    </tr>
                    {{range .Projects}}
                        <tr>
                            <td><a href='/project/view/{{.ID}}'>{{.Title}}</a></td>
                            <td>{{humanDate .Created}}</td>
                        </tr>
                    {{end}}
                </table>
                <div>
                    <input type='submit' formaction="/project/create" formmethod="get" value='Create Project'>
                </div>
            </form>
        {{else}}
            <p>There are no projects yet!</p>
        {{end}}
    {{else}}
        <p>Please <a href="/user/login">log in</a> to see your projects.</p>
    {{end}}
{{end}}