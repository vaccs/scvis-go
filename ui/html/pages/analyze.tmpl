{{define "title"}}Project #{{.Project.ID}}{{end}}

{{define "main"}}
    {{if .IsAuthenticated}}
        <div class='project'>
            <div class='metadata'>
                <strong>{{.Project.Title}}</strong>
                <span>#{{.Project.ID}}</span>
            </div>
            <div>
                {{if .Project.CFiles}}
                    <div>C Files in Project:</div>
                    <table>
                        <tr> 
                            <th style="text-align: left;">Name</th>
                            <th style="text-align: left;">Analysis Done</th>
                        </tr>
                        {{if .Project.Analysis}}
                            {{range .Project.CFiles}}
                                <tr>
                                    <td style="text-align: left;"><a href='/scvis/cfile/view/{{.ID}}'>{{.Filename}}</a></td>
                                    <td style="text-align: left;"><span style="color: green;">&#10004;</span></td>
                                </tr>
                            {{end}}
                        {{else}}
                            {{range .Project.CFiles}}
                                <tr>
                                    <td style="text-align: left;"><a href='/scvis/cfile/view/{{.ID}}'>{{.Filename}}</a></td>
                                    <td style="text-align: left;"><span style="color: red;">&#10008;</span></td>
                                </tr>
                            {{end}}
                        {{end}}
                    </table>
                {{else}}
                    <p>There are no C files in this project</p>    
                {{end}}
            </div>
            <div>
                {{if .Project.CFiles}}
                <form>
                    <input type='hidden' name='csrf_token' value='{{.CSRFToken}}'>
                    <input type='hidden' name='id' value='{{.Project.ID}}'>
                    <div>
                        <div id="command-line-section">
                            <label for="command-params">Enter Analysis Command-line Parameters:</label>
                            <input type="text" id="command-params" name="command-params" value='{{.Project.Parameters}}'>
                        </div>
                        {{if .Project.Analysis}}
                            {{if gt (len .Project.Analysis) 0}}
                                <input type='submit' formaction="/scvis/project/visual" formmethod="get" value='Visual'>
                            {{end}}
                        {{end}}
                        <input type='submit' formaction="/scvis/project/analyze" formmethod="post" value='Analyze'>
                        <input type="submit" formaction="/scvis/" formmethod="post" value="Done">
                    </div>
                </form>
                {{else}}
                    <form>
                        <input type='hidden' name='csrf_token' value='{{.CSRFToken}}'>
                        <input type='submit' formaction="/scvis/" formmethod="post" value="Done">
                    </form>
                {{end}}
            </div>
        </div>
    {{else}}
        <p>Please <a href="/scvis/user/login">log in</a> to view a project.</p>
    {{end}}
{{end}}