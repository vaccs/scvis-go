{{define "title"}}Analyze Project{{end}}

{{define "main"}}
    {{if .IsAuthenticated}}
        <style>
            /* Uses CSS variables for consistent theming */
            :root {
                --bg: var(--app-bg, #d4c4b0);
                --surface: var(--app-surface, #e8dcc8);
                --surface-2: var(--app-surface-2, #f0e8d8);
                --border: var(--app-border, #b8a68f);
                --text: var(--app-text, #3a2f23);
                --muted: var(--app-muted, #6b5d4f);
                --primary: var(--app-primary, #8b6f47);
                --primary-600: var(--app-primary-600, #705935);
                --accent: var(--app-accent, #9d7f53);
            }

            .analyze-container { margin-top: 0.5rem; }
            .analyze-header h2 { margin: 0 0 .25rem 0; color: var(--text); }
            .analyze-header p { margin: 0 0 1rem 0; color: var(--muted); }

            .analyze-grid {
                display: grid;
                grid-template-columns: 1fr 1fr;
                gap: 1.5rem;
                align-items: start;
            }

            .card {
                background: linear-gradient(180deg, var(--surface), var(--surface-2));
                border: 1px solid var(--border);
                border-radius: 10px;
                padding: 1rem;
                box-shadow: 0 1px 2px rgba(0,0,0,.2);
            }

            .card h3 { margin: 0 0 .75rem 0; color: var(--text); font-size: 1.05rem; }
            .hint { color: var(--muted); font-size: .9rem; margin: .35rem 0 0; }
            label { color: var(--text); display: block; margin-bottom: .35rem; }
            input[type="text"], select {
                background: var(--surface-2);
                color: var(--text);
                border: 1px solid var(--border);
                border-radius: 8px;
                padding: .6rem .7rem;
                width: 100%;
            }

            .file-list { margin-top: .5rem; }
            .file-list .file-item {
                display: flex;
                align-items: center;
                margin: .25rem 0;
                padding: .4rem .6rem;
                border-radius: 8px;
                background: rgba(56,189,248,0.08);
                border: 1px solid rgba(56,189,248,0.2);
            }
            .file-list .file-name {
                flex: 1;
                color: var(--text);
                font-size: .9rem;
            }
            .file-list .file-name a {
                color: var(--text);
                text-decoration: none;
            }
            .file-list .file-name a:hover {
                text-decoration: underline;
            }
            .file-list .analysis-status {
                padding: 0 .5rem;
                font-size: 1rem;
            }

            .actions { margin-top: 1rem; display: flex; gap: .75rem; flex-wrap: wrap; }
            .btn-primary {
                background: linear-gradient(180deg, var(--primary), var(--primary-600));
                color: #ffffff;
                border: 1px solid var(--primary-600);
                border-radius: 10px;
                padding: .65rem 1rem;
                font-weight: 700;
                cursor: pointer;
            }
            .btn-primary:hover { filter: brightness(1.05); }

            .no-files {
                padding: 2rem;
                text-align: center;
                color: var(--muted);
                font-style: italic;
            }

            @media (max-width: 900px) {
                .analyze-grid { grid-template-columns: 1fr; }
            }
        </style>

        <div class="analyze-container">
            <div class="analyze-header">
                <h2>{{.Project.Title}}</h2>
                <p>Analyze your project with the files below. Configure parameters and run the analysis.</p>
            </div>
        </div>
    
        <form action="/scvis/project/analyze" method="POST" enctype="multipart/form-data">
            <input type='hidden' name='csrf_token' value='{{.CSRFToken}}'>
            <input type='hidden' name='id' value='{{.Project.ID}}'>
            
            <div class="analyze-grid">
                <!-- Left: Files -->
                <section class="card">
                    <h3>Project Files</h3>

                    <div>
                        <strong style="color: var(--text); display: block; margin-bottom: .5rem;">C Files</strong>
                        {{if .Project.CFiles}}
                            <div class="file-list">
                                {{range .Project.CFiles}}
                                    <div class="file-item">
                                        <span class="file-name">
                                            <a href='#' onclick="viewCFile({{.ID}}); return false;">{{.Filename}}</a>
                                        </span>
                                        <span class="analysis-status">
                                            {{if $.Project.Analysis}}
                                                <span style="color: green;" title="Analysis complete">✓</span>
                                            {{else}}
                                                <span style="color: red;" title="No analysis">✗</span>
                                            {{end}}
                                        </span>
                                    </div>
                                {{end}}
                            </div>
                        {{else}}
                            <div class="no-files">No C files in this project</div>
                        {{end}}
                    </div>

                    <div style="height: .75rem"></div>

                    <div>
                        <strong style="color: var(--text); display: block; margin-bottom: .5rem;">Input Files</strong>
                        {{if .Project.InputFiles}}
                            <div class="file-list">
                                {{range .Project.InputFiles}}
                                    <div class="file-item">
                                        <span class="file-name">
                                            <a href='#' onclick="viewInputFile({{.ID}}); return false;">{{.Filename}}</a>
                                        </span>
                                    </div>
                                {{end}}
                            </div>
                        {{else}}
                            <div class="no-files">No input files in this project</div>
                        {{end}}
                        <p class="hint">Manage files from the <a href='/scvis/project/update'>Update Project</a> page.</p>
                    </div>
                </section>

                <!-- Right: Options -->
                <section class="card">
                    <h3>Analysis Options</h3>

                    <div>
                        <label>Application Parameters (optional)</label>
                        <input type="text" name="command-params" placeholder="" value="{{.Project.Parameters}}">
                        <p class="hint">Command-line parameters for your application (e.g., -cgo, -esp, -scc)</p>
                    </div>

                    <div style="margin-top:.75rem;">
                        <label for="stdin-file">Stdin Input File (optional)</label>
                        <select name="stdin-file" id="stdin-file">
                            <option value="">None</option>
                            {{range $index, $file := .Project.InputFiles}}
                                <option value="{{$index}}">{{$file.Filename}}</option>
                            {{end}}
                        </select>
                        <p class="hint">Choose an input file to pipe to stdin during analysis.</p>
                    </div>

                    <div class="actions">
                        {{if .Project.CFiles}}
                            <button class="btn-primary" type="submit">Analyze</button>
                            {{if .Project.Analysis}}
                                {{if gt (len .Project.Analysis) 2}}
                                    <button class="btn-primary" type="submit" formaction="/scvis/project/visual" formmethod="get">View Analysis</button>
                                {{end}}
                            {{end}}
                        {{end}}
                        <button class="btn-primary" type="submit" formaction="/scvis/home" formmethod="post">Done</button>
                    </div>
                </section>
            </div>
        </form>

        {{if .Flash}}
            <div class='flash'>{{.Flash}}</div>
        {{end}}
        
        <script nonce="{{.CSRFToken}}">
            function viewCFile(id) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/scvis/cfile/set';
                
                const csrfInput = document.createElement('input');
                csrfInput.type = 'hidden';
                csrfInput.name = 'csrf_token';
                csrfInput.value = '{{.CSRFToken}}';
                form.appendChild(csrfInput);
                
                const idInput = document.createElement('input');
                idInput.type = 'hidden';
                idInput.name = 'id';
                idInput.value = id;
                form.appendChild(idInput);
                
                document.body.appendChild(form);
                form.submit();
            }
            
            function viewInputFile(id) {
                const form = document.createElement('form');
                form.method = 'POST';
                form.action = '/scvis/input/set';
                
                const csrfInput = document.createElement('input');
                csrfInput.type = 'hidden';
                csrfInput.name = 'csrf_token';
                csrfInput.value = '{{.CSRFToken}}';
                form.appendChild(csrfInput);
                
                const idInput = document.createElement('input');
                idInput.type = 'hidden';
                idInput.name = 'id';
                idInput.value = id;
                form.appendChild(idInput);
                
                document.body.appendChild(form);
                form.submit();
            }
        </script>
    {{else}}
        <p>Please <a href="/scvis/user/login">log in</a> to view a project.</p>
    {{end}}
{{end}}