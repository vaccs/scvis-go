{{define "title"}}View Input File{{end}}

{{define "main"}}
    {{if .IsAuthenticated}}
        <h2>{{.InputFile.Filename}}</h2>
        <pre>{{.InputFile.Data}}</pre>

        <form>
            <input type='hidden' name='csrf_token' value='{{.CSRFToken}}'>
            <div>
                <input type='submit' formaction="/scvis/input/view/{{.InputFile.ID}}" formmethod="post" value='Back'>
            </div>
        </form>
    {{else}}
        <p>Please <a href="/scvis/user/login">log in</a> to view an input file from a project.</p>
    {{end}}
{{end}}
