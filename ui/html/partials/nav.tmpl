{{define "nav"}}
<nav>
    <div>
        <a href='/scvis/'>Home</a>
        {{if .IsAuthenticated}}
            {{if .IsAdministrator}}
                <a href='/scvis/user/signup'>Create User</a>
            {{end}}
            <a href='/scvis/user/change-password'>Change Password</a>
            <form action='/scvis/user/logout' method='POST'>
                <input type='hidden' name='csrf_token' value='{{.CSRFToken}}'>
                <button class='link'>Logout</button>
            </form>
        {{else}}
            <a href='/scvis/user/login'>Login</a>
        {{end}}
    </div>
</nav>
{{end}}