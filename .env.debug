# SCVis Production Configuration Template
# Copy this file to /opt/scvis/.env for production deployment

DB_HOST=localhost
DB_USER=scvis
DB_PASSWD=password # Update with your actual password
DB_NAME=scvis_local
PORT=8081

# Production Server Mode
LOCAL_SERVER=true

# Log Configuration
LOG_DIR=./log/scvisual
LOG_MAX_SIZE_MB=10
LOG_MAX_BACKUPS=5

# SSL Certificate Configuration
SSL_CERT_PATH=./tls/localhost.pem
SSL_KEY_PATH=./tls/localhost-key.pem
